# If you come from bash you might have to change your $PATH.
export PATH=/usr/local/bin:$HOME/.local/bin/:$HOME/go/bin:$HOME/.cargo/bin:$PATH

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Oh-my-zsh update
zstyle ':omz:update' mode auto
zstyle ':omz:update' verbosity silent
ZSH_CUSTOM_AUTOUPDATE_QUIET=true

# Uncomment the following line to display red dots whilst waiting for completion.
COMPLETION_WAITING_DOTS="true"

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins
plugins=(
  aliases
  aws
  autoupdate
  brew
  chezmoi
#  colorize
  command-not-found
  docker
  docker-compose
  fzf
  fzf-tab
  # git
  git-auto-fetch
  gitignore
  jsontools
  ssh
  starship
  terraform
  urltools
  zoxide
  zsh-autosuggestions
  zsh-interactive-cd
  # zsh-you-should-use
  zsh-syntax-highlighting
  {{- if eq .chezmoi.os "darwin" }}
  macos
  {{- end }}
)

# Set PATH, MANPATH, etc., for Homebrew.
{{ if eq .chezmoi.os "darwin" }}
eval "$(/opt/homebrew/bin/brew shellenv)"
fpath+="$(brew --prefix)/share/zsh/site-functions"
{{ else }}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{- end }}

# https://mise.jdx.dev
# eval "$(mise activate zsh)"


#############################################
# Run Oh-My-ZSH configuration
#############################################
source $ZSH/oh-my-zsh.sh


#############################################
# Completion
#############################################
complete -o nospace -C $(brew --prefix)/bin/terraform terraform


#############################################
# Aliases
#############################################

alias python="python3"
alias ve="source .venv/bin/activate"
alias de="deactivate"

alias cd="z"
alias ls="eza -1lF --icons --git --group-directories-first"
alias tree="l --tree"
alias h="history | fzf"
alias mkdir="mkdir -p"

alias n="nvim"

alias zsource="source ~/.zshrc"
alias cea="chezmoi edit --apply"
alias ca="chezmoi apply"

### Git
alias g="git"
alias gb="git branch"
alias gd="git diff --output-indicator-new=' ' --output-indicator-old=' '"
alias gds="git diff --staged"
alias ga="git add --patch"
alias gc="git commit"
alias gp="git push"
alias gu="git pull"
alias gs="git status --short"
alias gl="git log --all --graph --pretty=\
  format:'%C(magenta)%h %C(white) %an  %ar%C(auto)  %D%n%s%n'"
alias gcl="git clone"
alias gsw="git switch"

alias awscred='eval $(aws configure export-credentials --format env)'
alias awslocal="aws --profile localstack"

alias env="env | mask-sensitive-key-value-pairs"
